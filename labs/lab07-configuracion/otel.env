# Lab 7 · Configuración del SDK y del agente solo con variables de entorno.
# Uso: source otel.env && opentelemetry-instrument flask run -p 8080
# Referencias:
#   https://opentelemetry.io/docs/languages/sdk-configuration/general/
#   https://opentelemetry.io/docs/languages/sdk-configuration/otlp-exporter/
#   https://opentelemetry.io/docs/zero-code/python/configuration/

# Identidad del servicio (Resource)
export OTEL_SERVICE_NAME="dice-server"
export OTEL_RESOURCE_ATTRIBUTES="service.version=2.0.0,deployment.environment.name=lab"

# Exporters por señal
export OTEL_TRACES_EXPORTER="otlp"
export OTEL_METRICS_EXPORTER="otlp"
export OTEL_LOGS_EXPORTER="otlp"

# OTLP: protocolo y destino (gRPC → puerto 4317 · HTTP/protobuf → puerto 4318)
export OTEL_EXPORTER_OTLP_PROTOCOL="grpc"
export OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"

# Sampling: ParentBased(TraceIdRatioBased(1.0)) → todas las trazas raíz
export OTEL_TRACES_SAMPLER="parentbased_traceidratio"
export OTEL_TRACES_SAMPLER_ARG="1.0"

# Propagadores (este es el valor por defecto)
export OTEL_PROPAGATORS="tracecontext,baggage"

# Métricas cada 5 s (por defecto 60000 ms)
export OTEL_METRIC_EXPORT_INTERVAL="5000"

# Específicas de Python
export OTEL_PYTHON_EXCLUDED_URLS="health"
